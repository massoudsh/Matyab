# متریاب (MatYab) — backend env

# PostgreSQL
DATABASE_URL="postgresql://matyab:matyab@localhost:5432/matyab?schema=public"

# JWT
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# Redis (کش + صف quality scoring)
REDIS_URL="redis://localhost:6379"

# Object Storage (S3-compatible) — تصاویر مصالح
S3_ENDPOINT=""
S3_BUCKET="matyab-listings"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# سرور
PORT=4000
NODE_ENV="development"

# نرخ پایه‌ی محاسبه‌ی هزینه‌ی حمل (تومان به ازای هر کیلومتر برای هر تن)
SHIPPING_BASE_RATE_PER_KM=15000
