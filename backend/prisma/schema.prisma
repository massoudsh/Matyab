// متریاب (MatYab) — Prisma schema
// این فایل منبع اصلی truth برای مدل داده است. معادل خوانا: /db/schema.sql

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CONTRACTOR
  SUPPLIER
  ADMIN
}

enum ListingStatus {
  PENDING_REVIEW
  ACTIVE
  MATCHED
  SOLD
  EXPIRED
  REJECTED
}

enum RequestStatus {
  ACTIVE
  MATCHED
  FULFILLED
  EXPIRED
}

enum MatchStatus {
  SUGGESTED
  ACCEPTED
  REJECTED
}

enum QualityGrade {
  A
  B
  C
}

enum AssessmentSource {
  AI
  MANUAL
}

enum TransactionStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model User {
  id           String    @id @default(cuid())
  fullName     String
  phone        String    @unique
  passwordHash String
  role         UserRole
  city         String?
  trustScore   Float     @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  projects Project[]

  @@map("users")
}

model Project {
  id        String   @id @default(cuid())
  name      String
  city      String
  region    String?
  address   String?
  lat       Float?
  lng       Float?
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  createdAt DateTime @default(now())

  listings Listing[]
  requests MaterialRequest[]

  @@map("projects")
}

model MaterialCategory {
  id       String             @id @default(cuid())
  name     String
  parentId String?
  parent   MaterialCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children MaterialCategory[] @relation("CategoryTree")

  listings      Listing[]
  requests      MaterialRequest[]
  priceHistory  PriceHistory[]

  @@map("material_categories")
}

model Listing {
  id            String        @id @default(cuid())
  projectId     String
  project       Project       @relation(fields: [projectId], references: [id])
  categoryId    String
  category      MaterialCategory @relation(fields: [categoryId], references: [id])
  quantity      Float
  unit          String
  photos        String[]
  description   String?
  askingPrice   Float
  status        ListingStatus @default(PENDING_REVIEW)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  qualityAssessment QualityAssessment?
  priceSuggestion   PriceSuggestion?
  matches           Match[]

  @@map("listings")
}

model MaterialRequest {
  id          String         @id @default(cuid())
  projectId   String
  project     Project        @relation(fields: [projectId], references: [id])
  categoryId  String
  category    MaterialCategory @relation(fields: [categoryId], references: [id])
  quantity    Float
  budget      Float?
  deadline    DateTime?
  status      RequestStatus  @default(ACTIVE)
  createdAt   DateTime       @default(now())

  matches Match[]

  @@map("material_requests")
}

model QualityAssessment {
  id        String           @id @default(cuid())
  listingId String           @unique
  listing   Listing          @relation(fields: [listingId], references: [id])
  score     Int
  grade     QualityGrade
  notes     String?
  source    AssessmentSource @default(MANUAL)
  createdAt DateTime         @default(now())

  @@map("quality_assessments")
}

model PriceSuggestion {
  id           String   @id @default(cuid())
  listingId    String   @unique
  listing      Listing  @relation(fields: [listingId], references: [id])
  suggestedPrice Float
  minPrice     Float
  maxPrice     Float
  basis        String?
  createdAt    DateTime @default(now())

  @@map("price_suggestions")
}

model Match {
  id                String   @id @default(cuid())
  listingId         String
  listing           Listing  @relation(fields: [listingId], references: [id])
  requestId         String
  request           MaterialRequest @relation(fields: [requestId], references: [id])
  matchScore        Float
  reason            String?
  status            MatchStatus @default(SUGGESTED)
  createdAt         DateTime @default(now())

  shippingEstimate ShippingEstimate?
  transaction      Transaction?

  @@map("matches")
}

model ShippingEstimate {
  id             String  @id @default(cuid())
  matchId        String  @unique
  match          Match   @relation(fields: [matchId], references: [id])
  distanceKm     Float
  estimatedCost  Float
  createdAt      DateTime @default(now())

  @@map("shipping_estimates")
}

model Transaction {
  id            String            @id @default(cuid())
  matchId       String            @unique
  match         Match             @relation(fields: [matchId], references: [id])
  finalPrice    Float
  commission    Float
  status        TransactionStatus @default(PENDING)
  createdAt     DateTime          @default(now())

  reviews Review[]

  @@map("transactions")
}

model Review {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  rating        Int
  comment       String?
  createdAt     DateTime    @default(now())

  @@map("reviews")
}

model PriceHistory {
  id         String   @id @default(cuid())
  categoryId String
  category   MaterialCategory @relation(fields: [categoryId], references: [id])
  region     String
  price      Float
  recordedAt DateTime @default(now())

  @@map("price_history")
}
