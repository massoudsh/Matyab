// متریاب (MatYab) — Prisma schema
// این فایل منبع اصلی truth برای مدل داده است. معادل خوانا: /db/schema.sql

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CONTRACTOR
  SUPPLIER
  ADMIN
}

enum ListingStatus {
  PENDING_REVIEW
  ACTIVE
  MATCHED
  SOLD
  EXPIRED
  REJECTED
}

enum RequestStatus {
  ACTIVE
  MATCHED
  FULFILLED
  EXPIRED
}

enum MatchStatus {
  SUGGESTED
  ACCEPTED
  REJECTED
}

enum QualityGrade {
  A
  B
  C
}

enum AssessmentSource {
  AI
  MANUAL
}

enum TransactionStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum ProcurementOrderStatus {
  ORDERED
  DELIVERED
  DELAYED
  CANCELLED
}

enum NotificationType {
  MATCH_FOUND
  PROCUREMENT_CRITICAL
}

model User {
  id           String    @id @default(cuid())
  fullName     String
  phone        String    @unique
  passwordHash String
  role         UserRole
  city         String?
  trustScore   Float     @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  projects      Project[]
  notifications Notification[]

  @@map("users")
}

model Project {
  id        String   @id @default(cuid())
  name      String
  city      String
  region    String?
  address   String?
  lat       Float?
  lng       Float?
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  createdAt DateTime @default(now())

  listings Listing[]
  requests MaterialRequest[]
  boqItems BoqItem[]

  @@map("projects")
}

model MaterialCategory {
  id       String             @id @default(cuid())
  name     String
  parentId String?
  parent   MaterialCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children MaterialCategory[] @relation("CategoryTree")

  listings       Listing[]
  requests       MaterialRequest[]
  priceHistory   PriceHistory[]
  supplierQuotes SupplierQuote[]
  boqItems       BoqItem[]

  @@map("material_categories")
}

model Listing {
  id            String        @id @default(cuid())
  projectId     String
  project       Project       @relation(fields: [projectId], references: [id])
  categoryId    String
  category      MaterialCategory @relation(fields: [categoryId], references: [id])
  quantity      Float
  unit          String
  photos        String[]
  description   String?
  askingPrice   Float
  status           ListingStatus @default(PENDING_REVIEW)
  moderationReason String?
  moderatedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  qualityAssessment QualityAssessment?
  priceSuggestion   PriceSuggestion?
  matches           Match[]

  @@map("listings")
}

model MaterialRequest {
  id          String         @id @default(cuid())
  projectId   String
  project     Project        @relation(fields: [projectId], references: [id])
  categoryId  String
  category    MaterialCategory @relation(fields: [categoryId], references: [id])
  quantity    Float
  budget      Float?
  deadline    DateTime?
  status      RequestStatus  @default(ACTIVE)
  createdAt   DateTime       @default(now())

  matches Match[]

  @@map("material_requests")
}

model QualityAssessment {
  id        String           @id @default(cuid())
  listingId String           @unique
  listing   Listing          @relation(fields: [listingId], references: [id])
  score     Int
  grade     QualityGrade
  notes     String?
  source    AssessmentSource @default(MANUAL)
  createdAt DateTime         @default(now())

  @@map("quality_assessments")
}

model PriceSuggestion {
  id           String   @id @default(cuid())
  listingId    String   @unique
  listing      Listing  @relation(fields: [listingId], references: [id])
  suggestedPrice Float
  minPrice     Float
  maxPrice     Float
  basis        String?
  createdAt    DateTime @default(now())

  @@map("price_suggestions")
}

model Match {
  id                String   @id @default(cuid())
  listingId         String
  listing           Listing  @relation(fields: [listingId], references: [id])
  requestId         String
  request           MaterialRequest @relation(fields: [requestId], references: [id])
  matchScore        Float
  reason            String?
  status            MatchStatus @default(SUGGESTED)
  createdAt         DateTime @default(now())

  shippingEstimate ShippingEstimate?
  transaction      Transaction?

  @@map("matches")
}

model ShippingEstimate {
  id             String  @id @default(cuid())
  matchId        String  @unique
  match          Match   @relation(fields: [matchId], references: [id])
  distanceKm     Float
  estimatedCost  Float
  createdAt      DateTime @default(now())

  @@map("shipping_estimates")
}

model Transaction {
  id            String            @id @default(cuid())
  matchId       String            @unique
  match         Match             @relation(fields: [matchId], references: [id])
  finalPrice    Float
  commission    Float
  status        TransactionStatus @default(PENDING)
  createdAt     DateTime          @default(now())

  reviews Review[]

  @@map("transactions")
}

model Review {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  rating        Int
  comment       String?
  createdAt     DateTime    @default(now())

  @@map("reviews")
}

model PriceHistory {
  id         String   @id @default(cuid())
  categoryId String
  category   MaterialCategory @relation(fields: [categoryId], references: [id])
  region     String
  price      Float
  recordedAt DateTime @default(now())

  @@map("price_history")
}

// کوپایلوت تأمین (Procurement Copilot) — E13.
model Supplier {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  city      String?
  createdAt DateTime @default(now())

  quotes SupplierQuote[]
  orders ProcurementOrder[]

  @@map("suppliers")
}

model SupplierQuote {
  id           String           @id @default(cuid())
  supplierId   String
  supplier     Supplier         @relation(fields: [supplierId], references: [id])
  categoryId   String
  category     MaterialCategory @relation(fields: [categoryId], references: [id])
  unitPrice    Float
  leadTimeDays Int
  validUntil   DateTime?
  createdAt    DateTime         @default(now())

  @@map("supplier_quotes")
}

// ردیف BOQ (فهرست مقادیر): مصالحی که یک پروژه تا تاریخ مشخصی به آن نیاز دارد.
model BoqItem {
  id               String   @id @default(cuid())
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id])
  categoryId       String
  category         MaterialCategory @relation(fields: [categoryId], references: [id])
  requiredQuantity Float
  unit             String
  neededBy         DateTime
  orderedQuantity  Float    @default(0)
  createdAt        DateTime @default(now())

  orders ProcurementOrder[]

  @@map("boq_items")
}

model ProcurementOrder {
  id                   String                 @id @default(cuid())
  boqItemId            String
  boqItem              BoqItem                @relation(fields: [boqItemId], references: [id])
  supplierId           String
  supplier             Supplier               @relation(fields: [supplierId], references: [id])
  quantity             Float
  unitPrice            Float
  status               ProcurementOrderStatus @default(ORDERED)
  orderedAt            DateTime               @default(now())
  expectedDeliveryDate DateTime
  actualDeliveryDate   DateTime?

  @@map("procurement_orders")
}

// اعلان درون‌اپ برای مچ‌ها و قلم‌های بحرانی BOQ.
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  body      String?
  refType   String?
  refId     String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@map("notifications")
}
